cat << 'EOF' > .gitignore
# Environment & Secrets
.env
.env.local
.env.production
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
.pytest_cache/

# Node & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.pnp
.pnp.js

# IDEs & System Files
.vscode/
.idea/
.DS_Store
*.log
*.sqlite3

# Docker
*.pem
EOF
